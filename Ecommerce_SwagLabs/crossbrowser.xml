<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Cross Browser Test Suite">

    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <packages>
            <package name="ecom.swaglabs.tests.login"/>
            <package name="ecom.swaglabs.tests.product"/>
            <package name="ecom.swaglabs.tests.addtocart"/>
            <package name="ecom.swaglabs.tests.checkout"/>
            <package name="ecom.swaglabs.tests.hamburgermenu"/>
        </packages>
    </test>

    <test name="Firefox Tests">
        <parameter name="browser" value="firefox"/>
        <packages>
            <package name="ecom.swaglabs.tests.login"/>
            <package name="ecom.swaglabs.tests.product"/>
            <package name="ecom.swaglabs.tests.addtocart"/>
            <package name="ecom.swaglabs.tests.checkout"/>
            <package name="ecom.swaglabs.tests.hamburgermenu"/>
        </packages>
    </test>

</suite>